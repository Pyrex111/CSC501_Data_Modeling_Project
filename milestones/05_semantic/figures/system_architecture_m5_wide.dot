// Wide, text-width version of the M5 architecture figure derived from Shahmeer's
// system_architecture_m5.dot. It spans both columns (figure*) so the labels stay
// legible without the vertical space a tall single-column figure would cost; the
// caption carries the role of each layer.
// Render from the repository root:
//   dot -Tpdf milestones/05_semantic/figures/system_architecture_m5_wide.dot \
//        -o milestones/05_semantic/figures/system_architecture_m5_wide.pdf
//   dot -Tpng -Gdpi=300 milestones/05_semantic/figures/system_architecture_m5_wide.dot \
//        -o milestones/05_semantic/figures/system_architecture_m5_wide.png
digraph ETFArchitectureM5Wide {
  rankdir=LR;
  nodesep=0.18;
  ranksep=0.22;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9,
        margin="0.07,0.04"];
  edge [fontname="Helvetica", fontsize=8.5, color="#444444"];

  ui [label="Flask routes (src/ui)", fillcolor="#eaf2fb", color="#9db7d5"];
  biz [label="Business helpers (src/biz)\nparse, check input, explain errors", fillcolor="#fff3de", color="#e3c48f"];
  access [label="Graph repositories + lookups\nSPARQL; validate candidate writes", fillcolor="#edf6ed", color="#9cc79c"];
  store [label="Oxigraph store\ndata (ABox) + ontology (TBox)", fillcolor="#f2edf8", color="#b9a6d6"];

  {rank=same; biz; access;}
  ui -> biz [label="parse / explain"];
  ui -> access [label="query / mutate"];
  access -> store [label="SELECT / validated delta"];
}

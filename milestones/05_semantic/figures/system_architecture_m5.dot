// Milestone 5 architecture (Shahmeer). Render from the repository root:
//   dot -Tpdf milestones/05_semantic/figures/system_architecture_m5.dot -o milestones/05_semantic/figures/system_architecture_m5.pdf
//   dot -Tpng -Gdpi=200 milestones/05_semantic/figures/system_architecture_m5.dot -o milestones/05_semantic/figures/system_architecture_m5.png
digraph ETFArchitectureM5 {
  rankdir=TB;
  newrank=true;
  nodesep=0.35; ranksep=0.42;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.12,0.06"];
  edge [fontname="Helvetica", fontsize=8.5, color="#444444"];

  user [shape=plaintext, style="", label="User (browser)", fontsize=10];

  subgraph cluster_ui {
    label="User interface layer  (src/ui)"; fontname="Helvetica-Bold"; fontsize=10;
    style="rounded"; color="#9db7d5";
    routes [label="Flask routes + templates\nsearch · detail · create · batch update · delete · portfolio\nno SQL, no SPARQL", fillcolor="#eaf2fb"];
  }

  subgraph cluster_biz {
    label="Application / logic layer  (src/biz)"; fontname="Helvetica-Bold"; fontsize=10;
    style="rounded"; color="#e3c48f";
    biz [label="Business helpers\nparse + check form input, build payloads,\ntranslate validator messages", fillcolor="#fff3de"];
  }

  subgraph cluster_dal {
    label="Data access layer  (src/semantic, src/dal/models/semantic)"; fontname="Helvetica-Bold"; fontsize=10;
    style="rounded"; color="#9cc79c";
    runtime [label="semantic.runtime.open_graph_database()\none shared GraphDatabase per process", fillcolor="#edf6ed"];
    repos [label="Graph repositories + lookups\nSPARQL SELECT for reads;\nwrites staged on a candidate graph", fillcolor="#edf6ed"];
    validate [label="Validation before publish\n1. M4 parity bridge (relational rules)\n2. native graph validator (Mason):\nontology rules restated in code", fillcolor="#edf6ed"];
  }

  subgraph cluster_data {
    label="Data layer  (embedded Oxigraph triple store, data/semantic_store)"; fontname="Helvetica-Bold"; fontsize=10;
    style="rounded"; color="#b9a6d6";
    tbox [label="Ontology named graph (TBox)\netf_allocations.owl v1.1.0 · RDF/XML\nno reasoner; not read on writes", fillcolor="#f2edf8"];
    abox [label="Data named graph (ABox)\n356 synthetic triples · 12 classes", fillcolor="#f2edf8"];
  }

  setup [shape=note, style="filled", fillcolor="#ffffff",
         label="quickstart_semantic.py\nseed → RDF, load ontology, export demo.rdf,\ncompare 6 SPARQL vs SQL; --serve starts UI"];
  capture [shape=note, style="filled", fillcolor="#ffffff", label="data/raw synthetic source PDFs\n(retained-capture check)"];

  user -> routes [label="HTTP forms / links"];
  routes -> user [label="HTML + friendly messages", style=dashed];
  routes -> biz [label="parse / explain"];
  routes -> repos [label="same calls as M4\n(graph handle instead of SQL connection)"];
  runtime -> repos [label="shared instance", style=dashed];
  repos -> abox [label="SPARQL SELECT"];
  repos -> validate [label="candidate graph"];
  validate -> abox [label="one atomic\nINSERT/DELETE DATA delta\n(only if valid)"];
  capture -> validate [style=dashed];
  setup -> runtime [style=dotted];
  setup -> abox [style=dotted, label="populate"];
  setup -> tbox [style=dotted, label="load"];

  {rank=same; runtime; repos;}
  {rank=same; tbox; abox;}
}

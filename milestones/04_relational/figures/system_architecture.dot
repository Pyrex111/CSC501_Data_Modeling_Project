// Editable topology. Canonical report layout: scripts/generate_report_figures.py.
// Optional: dot -Tpdf system_architecture.dot -o architecture_graphviz.pdf
digraph ETFArchitecture {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  routes [label="UI: Flask routes + templates\nOpens a Database connection; renders forms/results", fillcolor="#eaf2fb"];
  biz [label="Business helpers\nParse/check input, build payloads, explain errors", fillcolor="#fff3de"];
  repos [label="DAL: repositories + lookups\nReceives the request connection; parameterized SQL", fillcolor="#edf6ed"];
  validator [label="validated_transaction\nFinal-state checks around writes", fillcolor="#edf6ed"];
  sqlite [label="SQLite\n12 STRICT tables, 13 FKs, 4 triggers", fillcolor="#f2edf8"];
  routes -> biz [label="parse/check input"];
  routes -> repos [label="connection + direct calls"];
  repos -> validator [label="writes"];
  repos -> sqlite [label="SQL"];
  validator -> sqlite [label="read proposed state", style=dashed];
  capture [shape=note, label="Synthetic source PDFs: existence checked\nonly when capture_root is supplied", fillcolor="#ffffff"];
  capture -> validator [style=dashed, label="optional file check"];
}

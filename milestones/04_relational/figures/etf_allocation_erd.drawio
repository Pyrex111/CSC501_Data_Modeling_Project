        <mxCell id="card_11_line_0" parent="card_11" vertex="1" value="Business key: (AllocationSnapshot, AllocationCategory)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=20;fontColor=#202020;">

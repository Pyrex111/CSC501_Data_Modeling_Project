        </mxCell>
        <mxCell id="card_0_line_2" parent="card_0" vertex="1" value="GivenName and FamilyName describe the individual." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=20;fontColor=#202020;">

        </mxCell>
        <mxCell id="card_11_line_1" parent="card_11" vertex="1" value="One weight per category in a snapshot; weight in [0, 1]." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=20;fontColor=#202020;">
          <mxGeometry x="18" y="102" width="624" height="38" as="geometry" />
        </mxCell>
        <mxCell id="card_11_line_2" parent="card_11" vertex="1" value="Its category and snapshot dimensions must agree." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=20;fontColor=#202020;">

        <mxCell id="title" parent="1" vertex="1" value="&lt;b&gt;Business identity and implementation rules&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=34;fontColor=#202020;">

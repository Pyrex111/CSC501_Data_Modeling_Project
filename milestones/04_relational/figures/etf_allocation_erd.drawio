        <mxCell id="card_11_line_3" parent="card_11" vertex="1" value="A recorded disclosure has at least one entry." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=20;fontColor=#202020;">
          <mxGeometry x="18" y="182" width="624" height="38" as="geometry" />
        </mxCell>
        <mxCell id="footer_0" parent="1" vertex="1" value="Unknown or unverified schemes/versions: use disclosure-local category contexts; similar labels do not prove equivalence." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=20;fontColor=#303030;">
          <mxGeometry x="68" y="1900" width="1365" height="42" as="geometry" />
        </mxCell>
        <mxCell id="footer_1" parent="1" vertex="1" value="Fractions use 0.30 for 30%. Complete-disclosure totals need a documented rounding tolerance; partial totals need not be 1." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=20;fontColor=#303030;">
          <mxGeometry x="68" y="1948" width="1365" height="42" as="geometry" />
        </mxCell>
        <mxCell id="footer_2" parent="1" vertex="1" value="SQL mapping: every relation has an autogenerated integer Id. Map relationships to FKs and enforce the scoped rules above." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=20;fontColor=#303030;">
          <mxGeometry x="68" y="1996" width="1365" height="42" as="geometry" />
        </mxCell>
        <mxCell id="footer_3" parent="1" vertex="1" value="Optional-key rules need null-aware uniqueness. Minimum one entry per completed snapshot needs transactional validation." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=20;fontColor=#303030;">
          <mxGeometry x="68" y="2044" width="1365" height="42" as="geometry" />
        </mxCell>
        <mxCell id="footer_4" parent="1" vertex="1" value="Revision prepared with AI assistance. Team members must review, validate and document their evaluation before submission." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=20;fontColor=#303030;">

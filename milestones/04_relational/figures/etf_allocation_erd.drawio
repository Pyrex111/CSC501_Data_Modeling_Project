        </mxCell>
        <mxCell id="subtitle" parent="1" vertex="1" value="Read with page 1. Parentheses indicate composite uniqueness rules. Related entities below denote relationships. The rules make prototype scope decisions explicit." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=22;fontColor=#303030;">

        <mxCell id="card_0_line_0" parent="card_0" vertex="1" value="Business key: CustomerNumber, within the single bank." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=20;fontColor=#202020;">

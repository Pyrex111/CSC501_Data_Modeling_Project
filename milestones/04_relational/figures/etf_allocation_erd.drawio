        </mxCell>
        <mxCell id="card_0_line_1" parent="card_0" vertex="1" value="CustomerNumber is the bank-issued customer reference." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=DejaVu Sans;fontSize=20;fontColor=#202020;">
